---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Heritage from '../components/Heritage.astro';
import Systems from '../components/Systems.astro';
import Maintenance from '../components/Maintenance.astro';
import Credentials from '../components/Credentials.astro';
import References from '../components/References.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Base>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <TrustStrip />
    <Heritage />
    <Systems />
    <Maintenance />
    <Credentials />
    <References />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <StickyBar />
</Base>
