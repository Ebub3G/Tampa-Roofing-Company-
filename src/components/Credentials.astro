---
import { company, leadership, buildingsRoofed, notableWork } from '../config';
import ExtLink from './ExtLink.astro';
---
<section class="section" id="credentials" aria-labelledby="cred-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="kicker">Credentials</p>
      <h2 id="cred-title">State licensed, with a record of industry service</h2>
      <p class="lead">Both principals are State Certified Roofing Contractors and Certified Professional Roofing Contractors. Brian Swope has also served the industry beyond this company.</p>
    </div>
    <div class="cred-grid">
      <div class="license-plate on-ink" data-reveal>
        <p class="license-label">State Certified Roofing Contractor</p>
        <p class="license-number">{company.license.number}</p>
        <p class="license-copy">Check any Florida roofing license yourself on <ExtLink href={company.license.verifyUrl}>MyFloridaLicense.com</ExtLink>. A roofing license, not an occupational license, is what lets a contractor pull your permit.</p>
      </div>
      <div class="people">
        {leadership.map((p) => (
          <article class="person" data-reveal>
            <h3>{p.name}</h3>
            <p class="person-role">{p.role}</p>
            <ul>{p.notes.map((n) => <li>{n}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
    <div class="roofed" data-reveal>
      <h3>Buildings we have roofed</h3>
      <ul class="roofed-list">{buildingsRoofed.map((b) => <li>{b}</li>)}</ul>
      <p class="roofed-note">{notableWork}</p>
    </div>
  </div>
</section>
