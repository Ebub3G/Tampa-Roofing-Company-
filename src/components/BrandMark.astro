---
// Monogram: a 6:12 gable over a flat deck line. Concept mark only, not the company's logo.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <rect x="0.75" y="0.75" width="38.5" height="38.5" fill="none" stroke="#B38A3C" stroke-width="1.5" />
  <path d="M6 22 L20 15 L34 22" fill="none" stroke="#B38A3C" stroke-width="3" stroke-linejoin="miter" />
  <path d="M8 28 H32" stroke="#FAFAF8" stroke-width="3" />
</svg>
